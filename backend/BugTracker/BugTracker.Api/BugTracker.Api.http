Content-Type: application/json

{
  "name": "Тестовый проект (изменён)",
  "version": "1.1",
  "repositoryUrl": "https://github.com/example/test",
  "description": "Описание изменено"
}

### 
DELETE {{host}}/api/software/1
pplication/json